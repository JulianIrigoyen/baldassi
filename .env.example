# Logging Level
# Options: debug, info, warn, error
# debug = verbose logging (all price checks, circuit breaker, errors)
# info = important events (opportunities, blocks, connections)
LOG_LEVEL=info

# Primary Ethereum Configuration
# Recommended: Use a reliable provider with WebSocket support (Alchemy, Infura, etc.)
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Fallback RPC Endpoints (automatic failover when primary fails)
# These are tried in order when the primary RPC is unavailable
FALLBACK_RPC_1=https://your-quicknode-endpoint.quiknode.pro/YOUR_KEY/
FALLBACK_RPC_2=https://go.getblock.us/YOUR_GETBLOCK_KEY
FALLBACK_RPC_3=https://ethereum-mainnet.core.chainstack.com/YOUR_KEY
FALLBACK_RPC_4=https://ethereum.publicnode.com
FALLBACK_RPC_5=https://1rpc.io/eth

# Fallback WebSocket Endpoints (for block monitoring)
# Note: Many public endpoints don't support eth_subscribe
FALLBACK_WS_1=wss://your-quicknode-endpoint.quiknode.pro/YOUR_KEY/
FALLBACK_WS_2=wss://ethereum-mainnet.core.chainstack.com/YOUR_KEY

# Binance (optional 2- public endpoints work without)
BINANCE_API_KEY=
BINANCE_API_SECRET=

#Infura
IFNURA_API_KEY=
IFNURA_API_SECRET=

# Arbitrage Settings
TRADE_SIZES=1.0,10.0,100.0
MIN_PROFIT_USD=1.0
MIN_PROFIT_PERCENT=0.01

# Trading Pairs (comma-separated list of pairs to monitor)
# Available pairs: ETH-USDC, USDT-USDC, LINK-USDC, UNI-USDC, AAVE-USDC, MATIC-USDC
# Defaults to ETH-USDC if not specified
# Each pair runs concurrently in its own worker for parallel arbitrage detection
# Recommended: ETH-USDC,USDT-USDC,AAVE-USDC,UNI-USDC,LINK-USDC,MATIC-USDC
TRADING_PAIRS=ETH-USDC,USDT-USDC,AAVE-USDC,UNI-USDC
